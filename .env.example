# Salin ke .env lalu isi nilainya: cp .env.example .env
# Buat secret acak dengan: openssl rand -hex 24
# Hindari karakter "$" pada nilai (dibaca Docker Compose sebagai variabel).

# URL publik aplikasi persis seperti yang dibuka di browser (tanpa "/" di akhir).
# Ganti ke https://domain-anda.com setelah memakai domain + SSL.
APP_URL=http://165.101.18.12

# Port lokal frontend yang dituju reverse proxy "/" di aaPanel
FRONTEND_PORT=5000

POSTGRES_PASSWORD=
JWT_SECRET=

# Kunci X-Sync-ApiKey untuk sinkronisasi antar instance. Kosongkan untuk mematikan akses sync via API key.
SYNC_API_KEY=
